{
  "name": "ai-toolkit-pi-package",
  "version": "0.4.0",
  "private": true,
  "description": "MaybeLL's engineering, learning, diagram and media skills for coding agents.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "productivity",
    "skills",
    "personal-toolkit"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./plugins/diagrams/skills",
      "./plugins/engineering/skills",
      "./plugins/learning/skills",
      "./plugins/media/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/validate-plugin-metadata.mjs && node scripts/validate-skills.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:video",
    "test:video": "python3 -B -m unittest discover -s tests -p '*_test.py'",
    "package": "npm run check && python3 scripts/package-skills.py"
  },
  "devDependencies": {
    "marked": "18.1.2",
    "skills": "1.7.4",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
